# כתובת האפליקציה (לקישורי חתימה ב-SMS/WhatsApp). אם ריק – נלקח מהבקשה.
APP_URL=https://app.example.co.il
# מפתח סודי ארוך ואקראי (חובה בפרודקשן)
APP_SECRET=change-me-to-a-long-random-string
# תיקיית נתונים: מסד SQLite + קבצי PDF חתומים. חייבת להיות על דיסק קבוע ומגובה.
DATA_DIR=./data
# ספק SMS: כל endpoint שמקבל POST {to, text, sender}. בלי זה האפליקציה במצב הדגמה (קודים מוצגים על המסך).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_SENDER=Chotmim
