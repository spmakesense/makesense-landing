# כתובת האפליקציה (לקישורי חתימה ב-SMS/WhatsApp). אם ריק – נלקח מהבקשה.
APP_URL=https://app.example.co.il
# Postgres (Vercel/Neon/Supabase). אם מוגדר – כל הנתונים וקבצי ה-PDF נשמרים בו ו-DATA_DIR לא בשימוש.
DATABASE_URL=
# מפתח סודי ארוך ואקראי. אם חסר – נגזר מ-DATABASE_URL.
APP_SECRET=change-me-to-a-long-random-string
# תיקיית נתונים: מסד SQLite + קבצי PDF חתומים. חייבת להיות על דיסק קבוע ומגובה.
DATA_DIR=./data
# ספק SMS: כל endpoint שמקבל POST {to, text, sender}. בלי זה האפליקציה במצב הדגמה (קודים מוצגים על המסך).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_SENDER=Chotmim
# Google Drive לשמירת הסכמים חתומים (ראו README – "חיבור Google Drive")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
